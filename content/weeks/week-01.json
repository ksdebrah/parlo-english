{
  "week": 1,
  "title": "Hello! Me and my family",
  "emoji": "👋",
  "intro": "Say hello, say your name and talk about your family.",
  "lessons": [
    {
      "id": "w1-l1",
      "level": "A1",
      "emoji": "👋",
      "title": "Hello and goodbye",
      "intro": "Your first English words. Tap 🔊 to listen. Then say it out loud.",
      "phrases": [
        { "en": "Hello!", "note": "Use this with everyone." },
        { "en": "Hi!", "note": "Friendly. For friends and family." },
        { "en": "Good morning.", "note": "Before 12 o'clock." },
        { "en": "Good afternoon.", "note": "From 12 o'clock to about 6 o'clock." },
        { "en": "Good evening.", "note": "After about 6 o'clock." },
        { "en": "How are you?", "note": "A question. People ask this a lot." },
        { "en": "I'm fine, thank you.", "note": "An easy answer to \"How are you?\"" },
        { "en": "Goodbye!", "note": "When you leave." },
        { "en": "See you later!", "note": "A friendly goodbye." }
      ],
      "tip": "\"Good night\" is only for going to bed. When you arrive in the evening, say \"Good evening\".",
      "dialogue": [
        { "who": "Anna", "line": "Hello! How are you?" },
        { "who": "You", "line": "I'm fine, thank you. And you?" },
        { "who": "Anna", "line": "I'm good, thanks." },
        { "who": "You", "line": "Goodbye! See you later!" }
      ]
    },
    {
      "id": "w1-l2",
      "level": "A1",
      "emoji": "🙋",
      "title": "My name is…",
      "intro": "Say your name and where you are from.",
      "phrases": [
        { "en": "What's your name?", "note": "A question. \"What's\" = \"What is\"." },
        { "en": "My name is Sam.", "note": "Say your own name." },
        { "en": "I'm Sam.", "note": "The same, but shorter. \"I'm\" = \"I am\"." },
        { "en": "Nice to meet you.", "note": "Say this when you meet someone new." },
        { "en": "Where are you from?", "note": "A question about your country." },
        { "en": "I'm from Spain.", "note": "Say your country." },
        { "en": "I live in London.", "note": "Say your city." },
        { "en": "Can you say that again, please?", "note": "Very useful when you don't understand!" }
      ],
      "tip": "Use \"please\" and \"thank you\" a lot. It is very polite in English.",
      "dialogue": [
        { "who": "Tom", "line": "Hi! What's your name?" },
        { "who": "You", "line": "My name is Sam. Nice to meet you." },
        { "who": "Tom", "line": "Nice to meet you too. Where are you from?" },
        { "who": "You", "line": "I'm from Spain. I live in London." }
      ]
    },
    {
      "id": "w1-l3",
      "level": "A1",
      "emoji": "👨‍👩‍👧",
      "title": "My family",
      "intro": "Talk about the people in your family.",
      "phrases": [
        { "en": "This is my mother.", "note": "\"This is\" introduces a person." },
        { "en": "This is my father.", "note": "Mother and father = parents." },
        { "en": "I have one brother.", "note": "Use \"have\" for family." },
        { "en": "I have two sisters.", "note": "More than one: add -s. sister → sisters." },
        { "en": "My son is five.", "note": "Age: \"He is five\" or \"He is five years old\"." },
        { "en": "My wife is a teacher.", "note": "Use \"a\" before a job: a teacher, a doctor." },
        { "en": "I'm married.", "note": "Or: I'm single." },
        { "en": "Do you have children?", "note": "A question. Children = more than one child." }
      ],
      "tip": "he = a man or boy. she = a woman or girl. My brother → he. My sister → she."
    }
  ],
