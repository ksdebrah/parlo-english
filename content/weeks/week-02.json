  "intro": "Learn food words and buy things in a shop or café.",
  "lessons": [
    {
      "id": "w2-l1",
      "level": "A1",
      "emoji": "🍎",
      "title": "Food I like",
      "intro": "Say what you like and what you don't like.",
      "phrases": [
        { "en": "I like rice.", "note": "\"I like\" + a thing." },
        { "en": "I don't like fish.", "note": "\"don't\" = \"do not\"." },
        { "en": "Do you like chicken?", "note": "A question. Start with \"Do you…?\"" },
        { "en": "Yes, I do.", "note": "A short answer: yes." },
        { "en": "No, I don't.", "note": "A short answer: no." },
        { "en": "I'm hungry.", "note": "You want to eat." },
        { "en": "I'm thirsty.", "note": "You want to drink." },
        { "en": "It's very good!", "note": "Say this when the food is nice." }
      ],
      "tip": "He or she: add -s to like. I like tea. She likes coffee."
    },
    {
      "id": "w2-l2",
      "level": "A1",
      "emoji": "☕",
      "title": "At the café",
      "intro": "Order food and drink. Always say \"please\"!",
      "phrases": [
        { "en": "Can I have a tea, please?", "note": "The easiest way to order." },
        { "en": "A coffee, please.", "note": "Short and polite." },
        { "en": "With milk, please.", "note": "Or: without milk." },
        { "en": "How much is it?", "note": "Ask the price." },
        { "en": "It's three pounds.", "note": "£3 = three pounds. 50p = fifty pence." },
        { "en": "Can I pay by card?", "note": "Card or cash?" },
        { "en": "Thank you very much!", "note": "Very polite." }
      ],
      "dialogue": [
        { "who": "Waiter", "line": "Hello! What would you like?" },
        { "who": "You", "line": "Can I have a tea, please?" },
        { "who": "Waiter", "line": "With milk?" },
        { "who": "You", "line": "Yes, please. How much is it?" },
        { "who": "Waiter", "line": "It's two pounds fifty." },
        { "who": "You", "line": "Can I pay by card?" },
        { "who": "Waiter", "line": "Yes, of course." }
      ]
    },
    {
      "id": "w2-l3",
      "level": "A1",
      "emoji": "🛒",
      "title": "In the shop",
      "intro": "Find things and pay in a shop.",
      "phrases": [
        { "en": "Excuse me.", "note": "Say this to start talking to someone." },
        { "en": "Where is the bread?", "note": "Ask where a thing is." },
        { "en": "It's over there.", "note": "The answer. They point to it." },
        { "en": "Do you have eggs?", "note": "Ask if the shop has it." },
        { "en": "I need a bag, please.", "note": "Bags often cost money in the UK." },
        { "en": "That's all, thank you.", "note": "You don't want more." }
      ],
      "tip": "Numbers for money: one, two, three, four, five, six, seven, eight, nine, ten. Practise them with the 🔊 button!"
    }
  ],
